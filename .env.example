# ============================================================
#  MAXFIY KALITLAR — bu faylni nusxalab ".env" deb saqlang
#  va o'z qiymatlaringizni qo'ying. .env faylini HECH KIMGA
#  bermang va GitHubga yuklamang!
# ============================================================

# --- Twilio (telefon qo'ng'iroq qiladigan xizmat) ---
# https://console.twilio.com dan oling
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio bergan raqamingiz (qo'ng'iroq shu raqamdan ketadi)
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- Serverning ommaviy (public) manzili ---
# Twilio shu manzilga ulanadi. Masalan ngrok yoki real domen.
# Oxirida "/" QO'YMANG.
PUBLIC_BASE_URL=https://sizning-domeningiz.example.com

# --- Claude AI (suhbat miyasi) ---
# https://console.anthropic.com dan oling
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Suhbat uchun model (tezlik uchun haiku, sifat uchun sonnet)
BRAIN_MODEL=claude-sonnet-4-6

# --- Mohir AI (o'zbekcha ovoz: TTS va STT) ---
# https://mohir.ai dan API kalit oling.
# Agar bo'sh qoldirilsa, tizim zaxira (fallback) ovozdan foydalanadi.
MOHIR_API_KEY=
MOHIR_TTS_URL=https://mohir.ai/api/v1/tts
MOHIR_STT_URL=https://mohir.ai/api/v1/stt

# --- Telegram admin bot (qo'ng'iroqlarni boshqarish) ---
# @BotFather dan TOKEN oling
TELEGRAM_BOT_TOKEN=
# Adminning Telegram ID si (@userinfobot dan oling)
ADMIN_ID=0

# --- Server porti ---
PORT=8000
