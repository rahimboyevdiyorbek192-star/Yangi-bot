# ============================================================
#  MAXFIY KALITLAR — bu faylni nusxalab ".env" deb saqlang
#  va o'z qiymatlaringizni qo'ying. .env faylini HECH KIMGA
#  bermang va GitHubga yuklamang!
# ============================================================

# --- Twilio (telefon qo'ng'iroq qiladigan xizmat) ---
# https://console.twilio.com dan oling
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio bergan raqamingiz (qo'ng'iroq shu raqamdan ketadi)
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- Serverning ommaviy (public) manzili ---
# Twilio shu manzilga ulanadi. Masalan ngrok yoki real domen.
# Oxirida "/" QO'YMANG.
PUBLIC_BASE_URL=https://sizning-domeningiz.example.com

# --- Claude AI (suhbat miyasi) ---
# https://console.anthropic.com dan oling
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Suhbat uchun model (tezlik uchun haiku, sifat uchun sonnet)
BRAIN_MODEL=claude-sonnet-4-6

# --- Mohir AI (o'zbekcha ovoz: TTS va STT) ---
# https://mohir.ai dan API kalit oling.
# Agar bo'sh qoldirilsa, tizim zaxira (fallback) ovozdan foydalanadi.
MOHIR_API_KEY=
MOHIR_TTS_URL=https://mohir.ai/api/v1/tts
MOHIR_STT_URL=https://mohir.ai/api/v1/stt

# --- Telegram admin bot (qo'ng'iroqlarni boshqarish) ---
# @BotFather dan TOKEN oling
TELEGRAM_BOT_TOKEN=
# Adminning Telegram ID si (@userinfobot dan oling)
ADMIN_ID=0

# ============================================================
#  VARIANT B — O'Z SIM KARTANGIZ (GSM modem + Asterisk)
#  Ovozli xabarni o'z raqamingizdan qo'ng'iroq qilib eshittirish uchun.
# ============================================================
# Sizning telefon raqamingiz (xodimga shu raqamdan qo'ng'iroq ketadi)
CALLER_ID=+998901112233
# Asterisk chan_dongle qurilma nomi (dongle.conf dagi [dongle0])
DONGLE_DEVICE=dongle0
# Asterisk qo'ng'iroq fayllari papkasi
ASTERISK_SPOOL_DIR=/var/spool/asterisk/outgoing
# Asterisk ovoz fayllari papkasi
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds
# extensions.conf dagi kontekst nomi
BROADCAST_CONTEXT=broadcast
# Ovozli xabar fayl nomi (kengaytmasiz)
BROADCAST_SOUND=xabar
# ffmpeg dasturi yo'li (odatda shunchaki "ffmpeg")
FFMPEG=ffmpeg

# --- Server porti (faqat Variant A / Twilio uchun) ---
PORT=8000
